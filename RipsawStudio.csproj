<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RipsawStudio</AssemblyName>
    <RootNamespace>RipsawStudio</RootNamespace>
    <Version>1.2</Version>
    <!-- Lets this project be built from Linux/macOS as well as Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Drop an appicon.ico next to this file and it is picked up automatically:
       as the exe's Win32 icon (Explorer, taskbar, shortcuts) and as the window icon
       (title bar, Alt+Tab). Both are conditional so the build works without it. -->
  <PropertyGroup Condition="Exists('appicon.ico')">
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('appicon.ico')">
    <EmbeddedResource Include="appicon.ico" LogicalName="RipsawStudio.appicon.ico" />
  </ItemGroup>

  <!-- Menu-bar icon artwork, embedded so the exe stays a single file. See UI/Assets.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\icon_capture.png" LogicalName="RipsawStudio.Assets.icon_capture.png" />
    <EmbeddedResource Include="Assets\icon_recording.png" LogicalName="RipsawStudio.Assets.icon_recording.png" />
    <EmbeddedResource Include="Assets\icon_keyboard.png" LogicalName="RipsawStudio.Assets.icon_keyboard.png" />
    <EmbeddedResource Include="Assets\icon_general.png" LogicalName="RipsawStudio.Assets.icon_general.png" />
    <EmbeddedResource Include="Assets\icon_about.png" LogicalName="RipsawStudio.Assets.icon_about.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>

</Project>
