<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>RipsawStudio</AssemblyName>
    <RootNamespace>RipsawStudio</RootNamespace>
    <Version>1.4</Version>
    <!-- Lets this project be built from Linux/macOS as well as Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Drop an appicon.ico next to this file and it is picked up automatically:
       as the exe's Win32 icon (Explorer, taskbar, shortcuts) and as the window icon
       (title bar, Alt+Tab). Both are conditional so the build works without it. -->
  <PropertyGroup Condition="Exists('appicon.ico')">
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('appicon.ico')">
    <EmbeddedResource Include="appicon.ico" LogicalName="RipsawStudio.appicon.ico" />
  </ItemGroup>

  <!-- Menu-bar icon artwork, embedded so the exe stays a single file. See UI/Assets.cs.
       Each is conditional on its own, same as appicon.ico above, so the build never fails
       over a missing PNG - drop any of these into Assets\ and it is picked up automatically,
       whether or not the others are present too. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\icon_capture.png" LogicalName="RipsawStudio.Assets.icon_capture.png" Condition="Exists('Assets\icon_capture.png')" />
    <EmbeddedResource Include="Assets\icon_recording.png" LogicalName="RipsawStudio.Assets.icon_recording.png" Condition="Exists('Assets\icon_recording.png')" />
    <EmbeddedResource Include="Assets\icon_keyboard.png" LogicalName="RipsawStudio.Assets.icon_keyboard.png" Condition="Exists('Assets\icon_keyboard.png')" />
    <EmbeddedResource Include="Assets\icon_general.png" LogicalName="RipsawStudio.Assets.icon_general.png" Condition="Exists('Assets\icon_general.png')" />
    <EmbeddedResource Include="Assets\icon_about.png" LogicalName="RipsawStudio.Assets.icon_about.png" Condition="Exists('Assets\icon_about.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>

  <!-- Tidies the portable release: after "dotnet publish", any NAudio*/Vortice*/SharpGen*
       dll left next to the exe is moved into its own subfolder, so the root only keeps
       RipsawStudio.exe and the RipsawStudio.* files. Program.cs registers a matching
       assembly-resolving hook so the app still finds them at runtime. -->
  <Target Name="OrganizeReleaseFolder" AfterTargets="Publish">
    <ItemGroup>
      <NAudioFiles Include="$(PublishDir)NAudio*.dll" />
      <VorticeFiles Include="$(PublishDir)Vortice*.dll" />
      <SharpGenFiles Include="$(PublishDir)SharpGen*.dll" />
    </ItemGroup>

    <RemoveDir Directories="$(PublishDir)NAudio" Condition="Exists('$(PublishDir)NAudio')" />
    <RemoveDir Directories="$(PublishDir)Vortice" Condition="Exists('$(PublishDir)Vortice')" />
    <RemoveDir Directories="$(PublishDir)SharpGen" Condition="Exists('$(PublishDir)SharpGen')" />

    <MakeDir Directories="$(PublishDir)NAudio" Condition="'@(NAudioFiles)' != ''" />
    <MakeDir Directories="$(PublishDir)Vortice" Condition="'@(VorticeFiles)' != ''" />
    <MakeDir Directories="$(PublishDir)SharpGen" Condition="'@(SharpGenFiles)' != ''" />

    <Move SourceFiles="@(NAudioFiles)" DestinationFolder="$(PublishDir)NAudio" Condition="'@(NAudioFiles)' != ''" />
    <Move SourceFiles="@(VorticeFiles)" DestinationFolder="$(PublishDir)Vortice" Condition="'@(VorticeFiles)' != ''" />
    <Move SourceFiles="@(SharpGenFiles)" DestinationFolder="$(PublishDir)SharpGen" Condition="'@(SharpGenFiles)' != ''" />
  </Target>

</Project>
